{
  "name": "codetogether",
  "displayName": "CodeTogether",
  "description": "Help developers understand agent-generated code changes.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {

    "configuration": {
  "title": "CodeTogether",
  "properties": {
    "codetogether.model": {
      "type": "string",
      "default": "",
      "description": "Ollama model name. Use an exact name from ollama list."
    },
    "codetogether.thinking": {
      "type": "boolean",
      "default": false,
      "description": "Enable thinking for models that support it. May improve reasoning but delay the visible answer. Models with mandatory thinking may ignore this setting."
    }
  }
},

    "commands": [ 
      
      {
        "command": "codetogether.helloWorld",
        "title": "Hello World"
      }, 
      
      {
      "command": "codetogether.explainChanges",
      "title": "CodeTogether: Understand This Change"
    },

    {
      "command": "codetogether.openReview",
      "title": "CodeTogether: Open Review"
    },

    {
      "command": "codetogether.understandCode",
      "title": "CodeTogether: Understand This Code"
    },
    {
      "command": "codetogether.chooseModel",
      "title": "CodeTogether: Choose Model"
    }

    ],
    "menus": {
      "editor/context": [
        { "command": "codetogether.understandCode", "when": "editorHasSelection", "group": "navigation" }
      ],
      "scm/resourceState/context": [
        { "command": "codetogether.explainChanges", "when": "scmProvider == git && scmResourceGroup == index", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/extension.test.js out/test/review.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
